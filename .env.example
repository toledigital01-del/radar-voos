# =============================================
# RADAR-VOOS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha
# =============================================

# SerpApi — Google Flights (cadastre grátis em serpapi.com)
SERPAPI_KEY=sua_api_key_aqui

# Banco de dados PostgreSQL (Railway ou Supabase)
# Formato: postgresql://usuario:senha@host:5432/nome_banco
DATABASE_URL=postgresql://usuario:senha@host:5432/radar_voos

# Redis (Railway Redis ou Upstash — opcional, para filas)
REDIS_URL=redis://localhost:6379

# Telegram Bot (crie em t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHANNEL_ID=@seu_canal_aqui

# WhatsApp via Twilio (twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=seu_auth_token_aqui
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email via SendGrid (sendgrid.com)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=alertas@seudominio.com
